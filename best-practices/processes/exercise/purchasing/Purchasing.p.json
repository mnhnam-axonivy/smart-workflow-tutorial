{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process.json",
  "id" : "19F4483D9D22111E",
  "config" : {
    "data" : "exercise.purchasing.ProcessData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "start",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Purchasing Request",
          "description" : "Start a new purchasing request"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f10", "to" : "f2" }
      ]
    }, {
      "id" : "f2",
      "type" : "Script",
      "name" : "Initialize",
      "config" : {
        "output" : {
          "code" : [
            "out.purchasingData.status = exercise.purchasing.PurchasingStatus.DRAFT;",
            "if (out.purchasingData.lineItems == null) {",
            "  out.purchasingData.lineItems = new java.util.ArrayList();",
            "}"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 224, "y" : 64 }
      },
      "connect" : [
        { "id" : "f11", "to" : "f3" }
      ]
    }, {
      "id" : "f3",
      "type" : "UserTask",
      "name" : "Create Purchasing Request",
      "config" : {
        "dialog" : "exercise.purchasing.PurchasingForm:start(exercise.purchasing.PurchasingData)",
        "call" : {
          "map" : {
            "param.purchasing" : "in.purchasingData"
          }
        },
        "task" : {
          "name" : "Create Purchasing Request",
          "skipTasklist" : true
        },
        "case" : {
          "name" : "Purchasing Request (#{ivy.session.sessionUserName})"
        },
        "output" : {
          "map" : {
            "out" : "in",
            "out.purchasingData" : "result.purchasing"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 392, "y" : 64 },
        "size" : { "width" : 128 }
      },
      "connect" : [
        { "id" : "f12", "to" : "f4" }
      ]
    }, {
      "id" : "f4",
      "type" : "Script",
      "name" : "Set Submitted",
      "config" : {
        "output" : {
          "code" : "out.purchasingData.status = exercise.purchasing.PurchasingStatus.SUBMITTED;"
        }
      },
      "visual" : {
        "at" : { "x" : 560, "y" : 64 }
      },
      "connect" : [
        { "id" : "f13", "to" : "f8" }
      ]
    }, {
      "id" : "f8",
      "type" : "ProgramInterface",
      "name" : "Decide Approval",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "You are a professional purchasing approval agent. Review the purchasing request thoroughly and return an ApprovalRecord with:\n- approvalNote: a concise professional review (2-3 sentences) covering business justification, cost reasonableness, and any concerns\n- isApproved: true if the request should be approved, false if it should be rejected\n\nApproval criteria:\n- Clear business justification in the notes\n- Line items are reasonable and appropriate for the department\n- Requester information is complete\n- No items appear unnecessary, duplicated, or excessive in quantity",
          "tools" : "[]",
          "resultType" : "exercise.common.ApprovalRecord.class",
          "resultMapping" : "in.approvalRecord",
          "query" : "Please review and assess this purchasing request:\n\nTitle: <%=in.purchasingData.title%>\nRequester: <%=in.purchasingData.requesterName%> (<%=in.purchasingData.requesterEmail%>)\nDepartment: <%=in.purchasingData.department%>\nTotal Amount: <%=in.purchasingData.totalAmount%>\nNotes: <%=in.purchasingData.notes%>\nLine Items: <%=in.purchasingData.lineItems%>"
        }
      },
      "visual" : {
        "at" : { "x" : 744, "y" : 64 },
        "size" : { "width" : 160, "height" : 62 }
      },
      "connect" : [
        { "id" : "f18", "to" : "f7" }
      ]
    }, {
      "id" : "f20",
      "type" : "Script",
      "name" : "Add Approval Record",
      "config" : {
        "output" : {
          "code" : [
            "in.approvalRecord.approverName = \"AI Assistant\";",
            "if (in.purchasingData.approvalRecords == null) {",
            "  in.purchasingData.approvalRecords = new java.util.ArrayList();",
            "}",
            "in.purchasingData.approvalRecords.add(in.approvalRecord);"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 1064, "y" : 64 }
      },
      "connect" : [
        { "id" : "f21", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "f7",
      "type" : "TaskSwitchEvent",
      "name" : "AI Approval Review",
      "config" : {
        "task" : {
          "name" : "AI Approval Review: <%= in1.purchasingData.title %>",
          "description" : "<%= in1.approvalRecord.approvalNote %>",
          "skipTasklist" : true,
          "customFields" : [
            { "name" : "aiAssisted", "type" : "STRING", "value" : "\"true\"" }
          ],
          "code" : [
            "import exercise.common.NoteCreator;",
            "NoteCreator.addNote(in1.approvalRecord.approvalNote);"
          ]
        },
        "output" : {
          "code" : "String x = \"\";"
        }
      },
      "visual" : {
        "at" : { "x" : 896, "y" : 64 },
        "labelOffset" : { "x" : 17, "y" : -23 }
      },
      "connect" : [
        { "id" : "f17", "to" : "f20" }
      ]
    }, {
      "id" : "f5",
      "type" : "Alternative",
      "name" : "Total > 100,000?",
      "config" : {
        "conditions" : {
          "f14" : "in.purchasingData.totalAmount != null && in.purchasingData.totalAmount > 100000"
        }
      },
      "visual" : {
        "at" : { "x" : 1184, "y" : 64 },
        "labelOffset" : { "y" : -24 }
      },
      "connect" : [
        { "id" : "f14", "to" : "f6", "label" : {
            "name" : "Yes",
            "segment" : 0.3,
            "offset" : { "x" : 17, "y" : 9 }
          } },
        { "id" : "f15", "to" : "f9", "label" : {
            "name" : "No",
            "offset" : { "x" : 1, "y" : -18 }
          } }
      ]
    }, {
      "id" : "f6",
      "type" : "TaskSwitchEvent",
      "name" : "Manual Approval (High Value)",
      "visual" : {
        "at" : { "x" : 1184, "y" : 168 }
      },
      "connect" : [
        { "id" : "f16", "to" : "f1" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 1288, "y" : 168 }
      }
    }, {
      "id" : "f9",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 1296, "y" : 64 }
      }
    } ]
}