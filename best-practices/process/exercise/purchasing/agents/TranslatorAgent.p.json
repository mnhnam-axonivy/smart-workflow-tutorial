{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process-1.json",
  "id" : "19F459C73FE4DE61",
  "kind" : "CALLABLE_SUB",
  "config" : {
    "data" : "exercise.purchasing.TranslatorAgentData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "CallSubStart",
      "name" : "translate(String,String)",
      "config" : {
        "signature" : "translate",
        "input" : {
          "params" : [
            { "name" : "extractedText", "type" : "String", "desc" : "Text to translate" },
            { "name" : "regionLanguage", "type" : "String", "desc" : "Target language name, e.g. Japanese, English" }
          ],
          "map" : {
            "out.extractedText" : "param.extractedText",
            "out.regionLanguage" : "param.regionLanguage"
          }
        },
        "result" : {
          "params" : [
            { "name" : "extractedText", "type" : "String", "desc" : "Translated text" }
          ],
          "map" : {
            "result.extractedText" : "in.extractedText"
          }
        }
      },
      "tags" : [
        "tool"
      ],
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "f1" }
      ]
    }, {
      "id" : "f1",
      "type" : "ProgramInterface",
      "name" : "Translate",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "You are a professional translator. Translate the provided text faithfully into the target language specified. Preserve all numbers, dates, names, and document structure. Return only the translated text without any explanation.",
          "tools" : "[]",
          "resultMapping" : "in.extractedText",
          "query" : "Translate the following text to <%= in.regionLanguage %>:\n\n<%= in.extractedText %>"
        }
      },
      "visual" : {
        "at" : { "x" : 256, "y" : 64 }
      },
      "connect" : [
        { "id" : "f3", "to" : "f4" }
      ]
    }, {
      "id" : "f4",
      "type" : "CallSubEnd",
      "visual" : {
        "at" : { "x" : 416, "y" : 64 }
      }
    } ]
}