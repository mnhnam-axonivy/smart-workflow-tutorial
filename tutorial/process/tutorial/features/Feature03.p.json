        }
      },
      "visual" : {
        "at" : { "x" : 480, "y" : 176 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "fD", "to" : "f1", "color" : "default" }
      ]
    } ],
  "layout" : {
