{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process-1.json",
  "id" : "19F04801A41E8613",
  "config" : {
    "data" : "tutorial.Feature03Data"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Acme Corp invoice processing",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Tutorial Feature 03: Invoice Analysis with Provider Override"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "fA" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 288, "y" : 176 }
      }
    }, {
      "id" : "f3",
      "type" : "TaskSwitchEvent",
      "name" : "Import Invoice",
      "config" : {
        "task" : {
          "skipTasklist" : true
        }
      },
      "visual" : {
        "at" : { "x" : 352, "y" : 64 }
      },
      "connect" : [
        { "id" : "f4", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "f5",
      "type" : "ProgramInterface",
      "name" : "Invoice Analysis Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "model" : "\"gpt-4o\"",
          "system" : "You are an invoice extraction agent for Acme Corp.\r\nYou receive a supplier invoice as text and extract the following fields:\r\n- invoiceNumber (String)\r\n- supplierName (String)\r\n- totalAmount (BigDecimal)\r\n- currency (String, ISO 4217)\r\n- invoiceDate (LocalDate, format yyyy-MM-dd)\r\n\r\nReturn only the structured data. Do not add commentary.\r\nIf a field is missing in the invoice, return null for that field.",
          "provider" : "\"OpenAI\"",
          "resultType" : "tutorial.InvoiceData.class",
          "resultMapping" : "in.invoiceData",
          "query" : "<%=in.invoiceText%>"
        }
      },
      "visual" : {
        "at" : { "x" : 480, "y" : 64 }
      },
      "connect" : [
        { "id" : "f6", "to" : "f7", "color" : "default" }
      ]
    }, {
      "id" : "f7",
      "type" : "ProgramInterface",
      "name" : "Urgency Classifier",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "model" : "\"claude-haiku-4-5\"",
          "system" : "You are an invoice urgency classifier for Acme Corp.\r\nGiven a total invoice amount, classify the urgency as exactly one of: URGENT, NORMAL, or LOW.\r\n- URGENT: amount is 10000 or above\r\n- NORMAL: amount is between 1000 (inclusive) and 10000 (exclusive)\r\n- LOW: amount is below 1000\r\nReturn only the single word. No explanation.",
          "provider" : "\"Anthropic\"",
          "resultMapping" : "in.urgency",
          "query" : "<%=in.invoiceData.totalAmount.toString()%>"
        }
      },
      "visual" : {
        "at" : { "x" : 656, "y" : 64 }
      },
      "connect" : [
        { "id" : "f8", "to" : "f9", "color" : "default" }
      ]
    }, {
      "id" : "f9",
      "type" : "ProgramInterface",
      "name" : "Supplier Risk Check",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "model" : "\"llama3.2\"",
          "system" : "You are a supplier risk classifier for Acme Corp.\r\nGiven a supplier name, classify its risk level as exactly one of: LOW, MEDIUM, or HIGH.\r\n- HIGH: supplier name is unknown, generic, or looks suspicious (e.g. single word, random characters, no recognisable company indicators)\r\n- MEDIUM: supplier name is plausible but unverifiable from name alone\r\n- LOW: supplier name clearly identifies a known, professional company\r\nReturn only the single word. No explanation.",
          "provider" : "\"Ollama\"",
          "resultMapping" : "in.riskLevel",
          "query" : "<%=in.invoiceData.supplierName%>"
        }
      },
      "visual" : {
        "at" : { "x" : 656, "y" : 176 }
      },
      "connect" : [
        { "id" : "f10", "to" : "fB", "color" : "default" }
      ]
    }, {
      "id" : "fA",
      "type" : "Script",
      "name" : "Mock data",
      "config" : {
        "output" : {
          "code" : [
            "in.invoiceText = \"INVOICE\\n\" +",
            "\"Invoice Number: INV-2024-00123\\n\" +",
            "\"Date: 2024-06-01\\n\" +",
            "\"Due Date: 2024-06-30\\n\" +",
            "\"\\n\" +",
            "\"Supplier:\\n\" +",
            "\"Acme Supplies Ltd.\\n\" +",
            "\"123 Commerce Street, Tokyo, Japan\\n\" +",
            "\"\\n\" +",
            "\"Bill To:\\n\" +",
            "\"Acme Corp\\n\" +",
            "\"456 Business Avenue, Osaka, Japan\\n\" +",
            "\"\\n\" +",
            "\"Description                  Qty   Unit Price   Total\\n\" +",
            "\"Office Supplies              10    500.00       5,000.00\\n\" +",
            "\"Printer Paper (A4, 500 pcs)   5    800.00       4,000.00\\n\" +",
            "\"Desk Organizer                3    200.00         600.00\\n\" +",
            "\"\\n\" +",
            "\"Subtotal: JPY 9,600.00\\n\" +",
            "\"Tax (10%): JPY 960.00\\n\" +",
            "\"Total Amount Due: JPY 10,560.00\\n\" +",
            "\"\\n\" +",
            "\"Payment Terms: Net 30\\n\" +",
            "\"Bank: Sumitomo Mitsui Banking Corporation\\n\" +",
            "\"Account Number: 1234567890\\n\";"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 224, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "fC", "to" : "f3", "color" : "default" }
      ]
    }, {
