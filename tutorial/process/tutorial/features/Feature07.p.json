{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process-1.json",
  "id" : "19F1290B5E27B487",
  "config" : {
    "data" : "tutorial.Feature07Data"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Web search",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Tutorial Feature 07: Web Search Tool"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "fA" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 800, "y" : 64 }
      }
    }, {
      "id" : "f3",
      "type" : "TaskSwitchEvent",
      "name" : "Run search",
      "config" : {
        "task" : {
          "skipTasklist" : true
        }
      },
      "visual" : {
        "at" : { "x" : 392, "y" : 64 }
      },
      "connect" : [
        { "id" : "f4", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "f5",
      "type" : "ProgramInterface",
      "name" : "Web Search Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "You are a research assistant.\r\nUse the webSearch tool to look up current information on the internet.\r\nAlways cite the source URL for each fact you use.\r\nSummarise the results in a clear, concise paragraph.",
          "tools" : "[\"webSearch\"]",
          "resultMapping" : "in.searchResult",
          "query" : "<%=in.query%>"
        }
      },
      "visual" : {
        "at" : { "x" : 520, "y" : 64 }
      },
      "connect" : [
        { "id" : "f6", "to" : "fB", "color" : "default" }
      ]
    }, {
      "id" : "fA",
      "type" : "Script",
      "name" : "Mock data",
      "config" : {
        "output" : {
          "code" : "in.query = \"What are the latest features in Axon Ivy 14?\";"
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f8", "to" : "f3", "color" : "default" }
      ]
    }, {
      "id" : "fB",
      "type" : "Script",
      "name" : "Show result",
      "config" : {
        "output" : {
          "code" : "ivy.log.error(in.searchResult);"
        }
      },
      "visual" : {
        "at" : { "x" : 680, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f10", "to" : "f1", "color" : "default" }
      ]
    } ],
  "layout" : {
    "colors" : {
      "red" : "#ff0000",
      "green" : "#1eff00",
      "yellow" : "#fbff00",
      "pink" : "#fb00ff"
    }
  }
}