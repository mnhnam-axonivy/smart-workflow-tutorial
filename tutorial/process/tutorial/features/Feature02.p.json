{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process-1.json",
  "id" : "19F04801A41E8612",
  "config" : {
    "data" : "tutorial.Feature02Data"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Acme Corp invoice processing",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Tutorial Feature 02: Invoice Analysis — Structured Output"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "f7" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 800, "y" : 64 }
      }
    }, {
      "id" : "f3",
      "type" : "TaskSwitchEvent",
      "name" : "Import Invoice",
      "config" : {
        "task" : {
          "skipTasklist" : true
        }
      },
      "visual" : {
        "at" : { "x" : 392, "y" : 64 }
      },
      "connect" : [
        { "id" : "f4", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "f5",
      "type" : "ProgramInterface",
      "name" : "Invoice Analysis Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "system" : "You are an invoice extraction agent for Acme Corp.\r\nYou receive a supplier invoice as text and extract the following fields:\r\n- invoiceNumber (String)\r\n- supplierName (String)\r\n- totalAmount (BigDecimal)\r\n- currency (String, ISO 4217)\r\n- invoiceDate (LocalDate, format yyyy-MM-dd)\r\n\r\nReturn only the structured data. Do not add commentary.\r\nIf a field is missing in the invoice, return null for that field.",
          "resultType" : "tutorial.InvoiceData.class",
          "resultMapping" : "in.result",
          "query" : "<%=in.invoiceText%>"
        }
      },
      "visual" : {
        "at" : { "x" : 520, "y" : 64 }
      },
      "connect" : [
        { "id" : "f6", "to" : "f9", "color" : "default" }
      ]
    }, {
      "id" : "f7",
      "type" : "Script",
      "name" : "Mock data",
      "config" : {
        "output" : {
          "code" : [
            "in.invoiceText = \"INVOICE\\n\" +",
            "\"Invoice Number: INV-2024-00123\\n\" +",
            "\"Date: 2024-06-01\\n\" +",
            "\"Due Date: 2024-06-30\\n\" +",
            "\"\\n\" +",
            "\"Supplier:\\n\" +",
            "\"Acme Supplies Ltd.\\n\" +",
            "\"123 Commerce Street, Tokyo, Japan\\n\" +",
            "\"\\n\" +",
            "\"Bill To:\\n\" +",
            "\"Acme Corp\\n\" +",
            "\"456 Business Avenue, Osaka, Japan\\n\" +",
            "\"\\n\" +",
            "\"Description                  Qty   Unit Price   Total\\n\" +",
            "\"Office Supplies              10    500.00       5,000.00\\n\" +",
            "\"Printer Paper (A4, 500 pcs)   5    800.00       4,000.00\\n\" +",
            "\"Desk Organizer                3    200.00         600.00\\n\" +",
            "\"\\n\" +",
            "\"Subtotal: JPY 9,600.00\\n\" +",
            "\"Tax (10%): JPY 960.00\\n\" +",
            "\"Total Amount Due: JPY 10,560.00\\n\" +",
            "\"\\n\" +",
            "\"Payment Terms: Net 30\\n\" +",
            "\"Bank: Sumitomo Mitsui Banking Corporation\\n\" +",
            "\"Account Number: 1234567890\\n\";"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f8", "to" : "f3", "color" : "default" }
      ]
    }, {
      "id" : "f9",
      "type" : "Script",
      "name" : "Show result from AI",
      "config" : {
        "output" : {
          "code" : "ivy.log.error(dev.langchain4j.internal.Json.toJson(in.result));"
        }
      },
      "visual" : {
        "at" : { "x" : 680, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f10", "to" : "f1", "color" : "default" }
      ]
    } ],
  "layout" : {
