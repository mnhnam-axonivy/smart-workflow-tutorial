            "in.query = \"Invoice #INV-2025-0891 from Office Depot. Total: $85 USD. Office stationery supplies. Due: 2025-08-01. Please process this invoice for approval.\";"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 432, "y" : 416 },
