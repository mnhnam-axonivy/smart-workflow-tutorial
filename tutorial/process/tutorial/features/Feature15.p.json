{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19F2C4A7B3D51E60",
  "config" : {
    "data" : "tutorial.Feature15Data"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Circuit breaker demo",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Tutorial Feature 15: Circuit Breaker demo"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "fA" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 768, "y" : 64 }
      }
    }, {
      "id" : "fA",
      "type" : "Script",
      "name" : "Mock data",
      "config" : {
        "output" : {
          "code" : [
            "in.invoiceText = \"Invoice Number: INV-2024-00123\\n\" +",
            "\"Supplier: Acme Supplies Ltd.\\n\" +",
            "\"Total Amount Due: JPY 10,560.00\\n\" +",
            "\"Due Date: 2024-06-30\\n\";",
            "in.isStopped = false;"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f8", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "f5",
      "type" : "ProgramInterface",
      "name" : "Invoice Summary Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "resultMapping" : "in.summary",
          "system" : "You are an invoice summary agent for Acme Corp.\r\nRead the invoice text and return a single sentence summary containing:\r\nthe invoice number, supplier name, total amount, and due date.\r\nDo not add any other commentary.",
          "query" : "<%=in.invoiceText%>"
        }
      },
      "visual" : {
        "at" : { "x" : 432, "y" : 64 },
        "size" : { "width" : 160, "height" : 62 }
      },
      "boundaries" : [ {
          "id" : "fE",
          "type" : "ErrorBoundaryEvent",
          "name" : "Agent stopped",
          "config" : {
            "errorCode" : "smartworkflow:stop",
            "output" : {
              "map" : {
                "out" : "in",
                "out.error" : "error"
              }
            }
          },
          "visual" : {
            "at" : { "x" : 488, "y" : 105 },
            "labelOffset" : { "x" : -55, "y" : 25 },
            "icon" : "res:/webContent/icons/shield.png"
          },
          "connect" : [
            { "id" : "fE1", "to" : "fC" }
          ]
        } ],
      "connect" : [
        { "id" : "f6", "to" : "f9", "color" : "default" }
      ]
    }, {
      "id" : "f9",
      "type" : "Script",
      "name" : "Show result from AI",
      "config" : {
        "output" : {
          "code" : "ivy.log.error(in.summary);"
        }
      },
      "visual" : {
        "at" : { "x" : 624, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f10", "to" : "f1", "color" : "default" }
      ]
    }, {
      "id" : "fC",
      "type" : "Script",
      "name" : "Fallback: manual review",
      "config" : {
        "output" : {
          "code" : [
            "in.isStopped = true;",
            "in.summary = \"AI is currently unavailable - invoice routed to manual review.\";",
            "ivy.log.warn(\"Agent stopped by circuit breaker: {0}\", in.error.getMessage());",
            "ivy.log.error(in.summary);",
            "in.error = null;"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 488, "y" : 192 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "fC1", "to" : "f1", "via" : [ { "x" : 768, "y" : 192 } ] }
      ]
    }, {
      "id" : "f20",
      "type" : "RequestStart",
      "name" : "Stop all agents",
      "config" : {
        "signature" : "stopAll",
        "request" : {
          "name" : "Tutorial Feature 15: Stop all agents"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 320 }
      },
      "connect" : [
        { "id" : "f21", "to" : "f22" }
      ]
    }, {
      "id" : "f22",
      "type" : "Script",
      "name" : "Stop all agents",
      "config" : {
        "output" : {
          "code" : [
            "import com.axonivy.utils.smart.workflow.guardrails.circuitbreaker.CircuitBreakerSignal;",
            "",
            "CircuitBreakerSignal.stopAll();",
            "ivy.log.warn(\"Circuit breaker ON: all AI agent calls in this application are stopped.\");"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 320 }
      },
      "connect" : [
        { "id" : "f23", "to" : "f24" }
      ]
    }, {
      "id" : "f24",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 432, "y" : 320 }
      }
    }, {
      "id" : "f30",
      "type" : "RequestStart",
      "name" : "Re-enable agents",
      "config" : {
        "signature" : "reEnableAgents",
        "request" : {
          "name" : "Tutorial Feature 15: Re-enable agents"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 416 }
      },
      "connect" : [
        { "id" : "f31", "to" : "f32" }
      ]
    }, {
      "id" : "f32",
      "type" : "Script",
      "name" : "Re-enable agents",
      "config" : {
        "output" : {
          "code" : [
            "import com.axonivy.utils.smart.workflow.guardrails.circuitbreaker.CircuitBreakerSignal;",
            "",
            "CircuitBreakerSignal.resumeAll();",
            "ivy.log.warn(\"Circuit breaker OFF: new AI agent calls are allowed again. Calls stopped earlier are not re-run.\");"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 416 }
      },
      "connect" : [
        { "id" : "f33", "to" : "f34" }
      ]
    }, {
      "id" : "f34",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 432, "y" : 416 }
      }
    } ],
  "layout" : {
    "colors" : {
      "red" : "#ff0000",
      "green" : "#1eff00",
      "yellow" : "#fbff00",
      "pink" : "#fb00ff"
    }
  }
}
