{
  "$schema" : "https://json-schema.axonivy.com/14.0-dev/project/process-1.json",
  "id" : "19F11A0A6B218909",
  "config" : {
    "data" : "tutorial.Feature09Data"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "Sensitive data output guardrail demo",
      "config" : {
        "signature" : "start",
        "request" : {
          "name" : "Tutorial Feature 09: Output Guardrail"
        }
      },
      "visual" : {
        "at" : { "x" : 96, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "fA" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "visual" : {
        "at" : { "x" : 632, "y" : 64 }
      }
    }, {
      "id" : "f5",
      "type" : "ProgramInterface",
      "name" : "Assistant Agent",
      "config" : {
        "javaClass" : "com.axonivy.utils.smart.workflow.AgenticProcessCall",
        "userConfig" : {
          "outputGuardrails" : "[\"SensitiveDataOutputGuardrail\"]",
          "resultMapping" : "in.result",
          "query" : "<%=in.query%>"
        }
      },
      "visual" : {
        "at" : { "x" : 432, "y" : 64 },
        "size" : { "width" : 160, "height" : 62 }
      },
      "boundaries" : [ {
          "id" : "fE",
          "type" : "ErrorBoundaryEvent",
          "name" : "Guardrail blocked",
          "config" : {
            "errorCode" : "smartworkflow:guardrail:output:violation",
            "output" : {
              "map" : {
                "out" : "in",
                "out.error" : "error"
              }
            }
          },
          "visual" : {
            "at" : { "x" : 488, "y" : 105 },
            "labelOffset" : { "x" : -60, "y" : 25 },
            "icon" : "res:/webContent/icons/shield.png"
          },
          "connect" : [
            { "id" : "fE1", "to" : "fC" }
          ]
        } ],
      "connect" : [
        { "id" : "f6", "to" : "f1", "color" : "default" }
      ]
    }, {
      "id" : "fA",
      "type" : "Script",
      "name" : "Mock query",
      "config" : {
        "output" : {
          "code" : "in.query = \"What is the format of an OpenAI API key? Please give examples.\";"
        }
      },
      "visual" : {
        "at" : { "x" : 264, "y" : 64 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "f8", "to" : "f5", "color" : "default" }
      ]
    }, {
      "id" : "fC",
      "type" : "Script",
      "name" : "Show violation",
      "config" : {
        "output" : {
          "code" : [
            "in.result = \"Blocked by guardrail: \" + in.error.getMessage();",
            "ivy.log.error(in.result);",
            "in.error = null;"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 488, "y" : 192 },
        "color" : "yellow"
      },
      "connect" : [
        { "id" : "fC1", "to" : "f1", "via" : [ { "x" : 632, "y" : 192 } ] }
      ]
    } ],
  "layout" : {
    "colors" : {
      "red" : "#ff0000",
      "green" : "#1eff00",
      "yellow" : "#fbff00",
      "pink" : "#fb00ff"
    }
  }
}